# ------------------------------------------------------------------
# Showrunner — AI entertainment content platform
# Copy to .env and fill in values. Nothing here belongs in git.
# ------------------------------------------------------------------

# --- Database (required) ------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Provider selection --------------------------------------------
# Each capability resolves through src/lib/services. Currently the only
# registered adapter is "mock"; real adapters (OpenAI, Anthropic,
# ElevenLabs, YouTube Data, ...) register in the same maps and are
# selected here without any UI/engine code changes.
AI_MODEL_PROVIDER=mock            # mock | openai | anthropic
STORY_DISCOVERY_PROVIDER=mock     # mock | newsapi | reddit | rss
RESEARCH_PROVIDER=mock            # mock | tavily | exa
TTS_PROVIDER=mock                 # mock | elevenlabs
MEDIA_PROVIDER=mock               # mock | runway | stability
PUBLISHING_PROVIDER=mock          # mock | youtube | tiktok | instagram | x
ANALYTICS_PROVIDER=mock           # mock | youtube | platform-native

# --- AI models (Story Judge) -----------------------------------------
# Used for story evaluation. JUDGE_PROVIDER picks the adapter:
#   anthropic | openai | heuristic (deterministic scoring, no key needed)
# With JUDGE_PROVIDER unset, the platform auto-detects from available keys,
# falling back to the heuristic scorer.
JUDGE_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Scheduler --------------------------------------------------------
# Shared secret protecting /api/cron/scout (Vercel Cron sends it as a
# Bearer token automatically when set).
CRON_SECRET=

# --- Story discovery ------------------------------------------------
NEWS_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Research / search ----------------------------------------------
TAVILY_API_KEY=
EXA_API_KEY=

# --- Text-to-speech --------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

# --- Image / video generation ---------------------------------------
RUNWAY_API_KEY=
STABILITY_API_KEY=

# --- Social publishing ----------------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_ACCESS_TOKEN=
X_API_KEY=
X_API_SECRET=

# --- Automation ------------------------------------------------------
# Initial values are stored in the automation_settings table and can be
# changed live from the dashboard; these seed the first run.
AUTOMATION_ENABLED=true
DISCOVERY_INTERVAL_HOURS=6

# --- Phase 4: media generation providers ------------------------------
# Images: openai | stability | (unset → local SVG scene renderer, labelled fallback)
IMAGE_PROVIDER=
OPENAI_IMAGE_MODEL=gpt-image-1
# Speech: elevenlabs | openai | (unset → narration reported UNAVAILABLE, never faked)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
ELEVENLABS_MODEL=eleven_multilingual_v2
# Video render: local-ffmpeg (bundled, no external cost) or a future provider key
VIDEO_RENDER_PROVIDER=local-ffmpeg

# --- Phase 6: YouTube publishing + analytics --------------------------
# Google Cloud OAuth client (type: Web application).
# Authorized redirect URI must be:  <APP_URL>/api/oauth/youtube/callback
# Required scopes are requested automatically:
#   youtube.upload, youtube.readonly, yt-analytics.readonly
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Public base URL used to build the OAuth redirect URI.
OAUTH_REDIRECT_BASE_URL=http://localhost:3000
# REQUIRED to store OAuth tokens. Min 16 chars; rotating it invalidates
# all stored tokens (accounts must reconnect). Never commit a real value.
TOKEN_ENCRYPTION_KEY=
